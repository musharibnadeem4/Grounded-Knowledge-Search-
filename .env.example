# Environment variables for drg. Copy to .env and edit: `cp .env.example .env` (Windows: copy .env.example .env).
# .env is git-ignored and is read by `ask` (python-dotenv). Real environment variables take precedence over .env.
# No real values belong in this file. Retrieval/answer flags are NOT environment variables: they live in
# drg/config.py (and can be overridden per eval run with `run_eval.py --set KEY=VALUE`).

# LLM provider for `ask`: "groq" (hosted, free tier) or "ollama" (local, no account).
LLM_PROVIDER=groq

# Model name for the chosen provider. If empty, a default is used
# (groq: llama-3.3-70b-versatile, ollama: llama3.1:8b). Example for groq: openai/gpt-oss-120b
# Note: Groq's free tier caps each model at ~200,000 tokens per day and 8,000 tokens per minute.
LLM_MODEL=

# --- groq: create a free key at https://console.groq.com ---
GROQ_API_KEY=

# --- ollama: runs locally (https://ollama.com; `ollama pull <model>`) ---
# Default is http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Optional: force the Hugging Face cache to be used offline (1) or online (0).
# Unset = automatic (offline once the embedding model is cached).
# HF_HUB_OFFLINE=1
