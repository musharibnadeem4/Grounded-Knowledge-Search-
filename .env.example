# Environment variables for drg. Copy to .env and edit; .env is read by `ask` (python-dotenv).
# Real environment variables take precedence over .env.

# LLM provider for `ask`: "groq" or "ollama".
LLM_PROVIDER=groq

# Model name for the chosen provider. If empty, a default is used
# (groq: llama-3.3-70b-versatile, ollama: llama3.1:8b).
LLM_MODEL=

# --- groq: hosted, free tier available (create a key at https://console.groq.com) ---
GROQ_API_KEY=

# --- ollama: runs locally, no account needed (https://ollama.com; `ollama pull <model>`) ---
# Default is http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Optional: force the Hugging Face cache to be used offline (1) or online (0).
# Unset = automatic (offline when the models are already cached).
# HF_HUB_OFFLINE=1
